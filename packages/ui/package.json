{
  "name": "@pdfweave/ui",
  "version": "0.1.0",
  "description": "TypeScript base PDF generator and React base UI. Open source, developed by the community, and completely free to use under the MIT license!",
  "keywords": [
    "pdf",
    "pdf-designer",
    "pdf-generation",
    "pdf-viewer",
    "pdfweave",
    "react",
    "typescript"
  ],
  "homepage": "https://pdfweave.dev",
  "bugs": {
    "url": "https://github.com/IDNTEQ/pdfweave/issues"
  },
  "license": "MIT",
  "author": "PDFweave contributors (forked from pdfme by hand-dot)",
  "repository": {
    "type": "git",
    "url": "https://github.com/IDNTEQ/pdfweave.git",
    "directory": "packages/ui"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "lint": "vp lint -c ../../.oxlintrc.json src",
    "fmt": "vp fmt -c ../../.oxfmtrc.json src --write",
    "test": "vitest run --config ../../vitest.config.ts",
    "coverage": "vitest run --config ../../vitest.config.ts --coverage"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.0.8",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@pdfweave/converter": "0.1.0",
    "@scena/react-guides": "^0.28.2",
    "antd": "^6.3.7",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.20",
    "dequal": "^2.0.3",
    "dompurify": "^3.4.12",
    "form-render": "^2.5.5",
    "hotkeys-js": "^4.0.3",
    "lucide-react": "^1.12.0",
    "rc-field-form": "^2.7.1",
    "rc-picker": "^4.11.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-moveable": "^0.56.0",
    "react-selecto": "^1.12.0"
  },
  "devDependencies": {
    "@pdfweave/common": "0.1.0",
    "@pdfweave/schemas": "0.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^6.0.3",
    "csstype": "^3.2.3",
    "vite": "^8.1.5",
    "vite-plugin-css-injected-by-js": "^5.0.1",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "peerDependencies": {
    "@pdfweave/common": "0.1.0",
    "@pdfweave/schemas": "0.1.0"
  }
}
